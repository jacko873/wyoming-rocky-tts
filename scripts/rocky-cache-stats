#!/usr/bin/env python3

import sys
import sqlite3
from pathlib import Path

def main():
    cache_db = Path("/var/cache/wyoming-rocky/cache.db")
    
    if not cache_db.exists():
        print("No cache database found")
        sys.exit(1)
    
    conn = sqlite3.connect(str(cache_db))
    
    # Get stats
    cursor = conn.execute("SELECT COUNT(*), SUM(hit_count), AVG(synthesis_duration_ms) FROM cache")
    total, hits, avg_time = cursor.fetchone()
    
    print(f"Cache Statistics:")
    print(f"  Total entries: {total or 0}")
    print(f"  Total hits: {hits or 0}")
    print(f"  Average synthesis: {avg_time or 0:.0f}ms")
    
    # Get cache size
    cache_dir = Path("/var/cache/wyoming-rocky")
    wav_files = list(cache_dir.glob("*.wav"))
    total_size = sum(f.stat().st_size for f in wav_files) / (1024 * 1024)
    print(f"  Cache size: {total_size:.1f} MB")
    
    # Show top entries
    print(f"\nTop 5 cached phrases:")
    cursor = conn.execute("""
        SELECT raw_text, hit_count 
        FROM cache 
        ORDER BY hit_count DESC 
        LIMIT 5
    """)
    
    for i, (text, hits) in enumerate(cursor.fetchall(), 1):
        text_preview = text[:50] + "..." if len(text) > 50 else text
        print(f"  {i}. [{hits} hits] {text_preview}")
    
    conn.close()

if __name__ == '__main__':
    main()